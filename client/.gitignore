# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
scaffold-client.sh
# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.idea/

# ==============================================================================
# 1. DEPENDANCES (node_modules)
# ==============================================================================
node_modules/
**/node_modules/

# ==============================================================================
# 2. NESTJS (Dossier server)
# ==============================================================================
/server/dist/
/server/artifacts/
/server/coverage/
/server/.tscache/
/server/*.tsbuildinfo

# ==============================================================================
# 3. NEXT.JS (Dossier client)
# ==============================================================================
/client/.next/
/client/out/
/client/build/
/client/.lighthouse/

# ==============================================================================
# 4. VARIABLES D'ENVIRONNEMENT (Sécurité cruciale)
# ==============================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!*.env.example

# ==============================================================================
# 5. FICHIERS SYSTEME (Fedora / Linux / macOS)
# ==============================================================================
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~
*.swp

# ==============================================================================
# 6. EDITEURS DE CODE (VS Code, WebStorm, Cursor)
# ==============================================================================
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==============================================================================
# 7. LOGS ET DIAGNOSTICS
# ==============================================================================
*.log
pnpm-debug.log*
lerna-debug.log*

# ==============================================================================
# 8. TESTS ET COUVERTURE DE CODE
# ==============================================================================
.nyc_output/
coverage/
**/coverage/
.jest/
*.lcov
