# Environment
NODE_ENV=development
PORT=3000

# Database Configuration (Séparé)
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestion_stock
DB_SCHEMA=public

# Database URL (Prisma)
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=${DB_SCHEMA}"

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_EXPIRES_IN=1d

# Swagger Configuration
SWAGGER_TITLE=Gestion Stock API
SWAGGER_DESCRIPTION=API pour la gestion de stock, fournissant des fonctionnalités pour la gestion des produits, des utilisateurs et des commandes.
SWAGGER_VERSION=1.0.0
SWAGGER_EMAIL=swaggerstock@stock.com
SWAGGER_PASSWORD=swaggerstock@ddd123453