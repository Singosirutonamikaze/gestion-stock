# Environment
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:3001

# Database Configuration (PostgreSQL)
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestion_stock
DB_SCHEMA=public

# Database URL (Prisma)
DATABASE_URL="postgresql://your_db_user:your_db_password@localhost:5432/gestion_stock?schema=public"

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_EXPIRES_IN=1d

# Swagger Configuration
SWAGGER_TITLE=Gestion Stock API
SWAGGER_DESCRIPTION=API pour la gestion de stock, fournissant des fonctionnalités pour la gestion des produits, des utilisateurs et des commandes.
SWAGGER_VERSION=1.0.0
SWAGGER_EMAIL=swaggerstock@stock.com
SWAGGER_PASSWORD=swaggerstock@ddd123453

# Redis (Optionnel / Upstash)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""