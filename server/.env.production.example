# ============================================================
# GESTION DE STOCK - PRODUCTION ENVIRONMENT VARIABLES
# ============================================================

# Environment
NODE_ENV=production
PORT=3000
CLIENT_URL=https://votre-frontend-app.onrender.com

# Database URL (PostgreSQL Neon / Supabase / Cloud)
DATABASE_URL="postgresql://neondb_owner:VOTRE_MOT_DE_PASSE@ep-bold-rain-avrk0ts5-pooler.c-11.us-east-1.aws.neon.tech/neondb?sslmode=require"

# JWT & Security
JWT_SECRET=change_this_to_a_long_random_secure_secret_key_in_production
JWT_REFRESH_SECRET=change_this_to_another_long_random_secure_secret_key_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Swagger Documentation (Production Access)
SWAGGER_USER=admin
SWAGGER_PASSWORD=change_this_swagger_admin_password
SWAGGER_TITLE="API Gestion de Stock"
SWAGGER_DESCRIPTION="Documentation API REST Gestion de Stock"
SWAGGER_VERSION="1.0.0"

# Redis Cache (Optionnel)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
